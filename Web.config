<?xml version="1.0" encoding="utf-8"?>
<!--
  Reconstructed root Web.config (see README.md). The connection string name
  "ConStr" matches what every code-behind file reads via
  ConfigurationManager.ConnectionStrings["ConStr"] (one file, Student/Select_exam.aspx.cs,
  reads the key as "constr" - .NET's ConnectionStringSettingsCollection lookup is
  case-insensitive, so the single "ConStr" entry below satisfies both).
-->
<configuration>
  <connectionStrings>
    <add name="ConStr" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=EMS;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <pages controlRenderingCompatibilityVersion="4.0" />
    <sessionState mode="InProc" timeout="30" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
</configuration>
